# HuuQuantAI environment template
# Copy this file to .env for local development if your launcher loads dotenv.
# Do not commit real secrets. Keep real trading disabled unless a separate
# manual confirmation process is implemented and reviewed.

# ---------------------------------------------------------------------------
# DeepSeek AI Signal Advisor
# Required only when config/config.yaml has ai.enabled: true.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Binance Spot Testnet
# Optional. Paper trading does not need these values.
# These keys must be testnet keys, not mainnet keys.
# Current build keeps Testnet transport in dry-run/refusal mode and never sends mainnet orders.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ---------------------------------------------------------------------------
# Macro data
# Optional. Used for macro/risk context when available.
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Email notifications
# Optional. Leave blank to disable SMTP notifications.
HUU_SMTP_HOST=
HUU_SMTP_PORT=465
HUU_SMTP_USER=
HUU_SMTP_PASSWORD=
HUU_SMTP_RECIPIENT=

# ---------------------------------------------------------------------------
# Backend server overrides
# Desktop mode defaults to 127.0.0.1 and chooses/uses a local port.
AUTO_TRADER_HOST=127.0.0.1
AUTO_TRADER_PORT=8000

# Required by docker-compose for the first administrator account only.
# Use a long random value and enter it on the first-time setup form.
HUU_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# Frontend development variables
# Used when running the Vue app directly with npm run dev.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_WS_BASE_URL=ws://127.0.0.1:8000/api/v1/ws

# ---------------------------------------------------------------------------
# Build/runtime encoding helpers
# Usually set by scripts/build_desktop.py and desktop_backend.py automatically.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
